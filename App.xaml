<Application
    x:Class="totem.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="DefaultControlFocusVisualStyle" TargetType="Control" />
            <Style x:Key="FocusVisualStyle" TargetType="Control" />

            <Style TargetType="ContextMenu" BasedOn="{StaticResource UiContextMenu}">
                <Setter Property="FontFamily" Value="./font/#Open Sans" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style TargetType="MenuItem" BasedOn="{StaticResource UiMenuItem}">
                <Setter Property="FontFamily" Value="./font/#Open Sans" />
                <Setter Property="FontSize" Value="12" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
