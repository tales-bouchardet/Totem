<ui:FluentWindow
    x:Class="totem.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:totem"
    Title="Totem"
    Width="900"
    Height="700"
    FontFamily="./font/#Open Sans"
    FontSize="11.25"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None"
    WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <SolidColorBrush x:Key="TabViewSelectedItemBorderBrush" Color="#665719DD" />
        <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#181818" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="#14FFFFFF">
        <ui:TitleBar
            x:Name="AppTitleBar"
            Height="30"
            Padding="0,4,16,4"
            Title="Totem"
            Icon="pack://application:,,,/icon.ico">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Margin="-1,0,0,0">
                    <StackPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="VerticalAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8,3,8,3" />
                            <Setter Property="Margin" Value="0,3,0,2" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        </Style>
                    </StackPanel.Resources>
                    <Button x:Name="AboutButton" Content="Sobre" Click="AboutButton_Click" />
                    <Button Content="Importar" Click="ImportButton_Click" />
                    <Button Content="Exportar" Click="ExportButton_Click" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>
        </Border>

        <Popup
            x:Name="AboutPopup"
            Grid.Row="0"
            PlacementTarget="{Binding ElementName=AboutButton}"
            Placement="Bottom"
            StaysOpen="False"
            AllowsTransparency="True">
            <Border
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
                <StackPanel Width="220">
                    <Image
                        Source="pack://application:,,,/icon.ico"
                        Width="32"
                        Height="32"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="por: tales.bouchardet"
                        FontSize="11.25"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center" />
                    <TextBlock x:Name="VersionText" FontSize="11.25" HorizontalAlignment="Center" />
                    <Rectangle Height="1" Fill="#33FFFFFF" Margin="0,8,0,8" />
                    <TextBlock
                        x:Name="DotNetText"
                        FontSize="11.25"
                        FontStyle="Italic"
                        Foreground="#888888"
                        HorizontalAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Popup>

        <Grid Grid.Row="1">
            <TabControl x:Name="Tabs" BorderBrush="#33FFFFFF" SelectionChanged="Tabs_SelectionChanged">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#181818" Margin="15,16,15,10" Panel.ZIndex="1">
                                <local:TabWrapPanel
                                    IsItemsHost="True"
                                    KeyboardNavigation.TabIndex="1" />
                            </Border>
                            <Border
                                Grid.Row="1"
                                BorderThickness="0"
                                CornerRadius="0,4,4,4"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}"
                                KeyboardNavigation.TabIndex="2"
                                KeyboardNavigation.TabNavigation="Local"
                                KeyboardNavigation.DirectionalNavigation="Contained">
                                <ContentPresenter
                                    x:Name="PART_SelectedContentHost"
                                    ContentSource="SelectedContent"
                                    TextElement.Foreground="{TemplateBinding TextElement.Foreground}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                        <Setter Property="BorderBrush" Value="#12FFFFFF" />
                        <Setter Property="Foreground" Value="#7A7A7A" />
                        <Setter Property="HeaderTemplate" >
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBlock
                                        Text="{Binding}"
                                        FontSize="13.125"
                                        FontWeight="SemiBold"
                                        Padding="6,1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        TextAlignment="Center" />
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border
                                        x:Name="Border"
                                        MinHeight="0"
                                        Padding="6,4"
                                        Margin="2,0,2,2"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        Background="Transparent">
                                        <ContentPresenter
                                            x:Name="ContentSite"
                                            ContentSource="Header"
                                            RecognizesAccessKey="True"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Panel.ZIndex" Value="100" />
                                            <Setter TargetName="Border" Property="Background" Value="#0F1124" />
                                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource TabViewSelectedItemBorderBrush}" />
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource TabViewItemForegroundSelected}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="Tag" Value="AddButton">
                                <Setter Property="HeaderTemplate" Value="{x:Null}" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <ContentPresenter Content="{TemplateBinding Header}" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.ItemContainerStyle>
            </TabControl>
        </Grid>

        <ui:ContentDialogHost
            x:Name="RootContentDialogHost"
            Grid.Row="0"
            Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>
