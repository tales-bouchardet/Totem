<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="totem.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="titleBarArea" Grid.Row="0" Height="32">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Left"
                        Margin="8,4"
                        Spacing="2">

                <Button Content="Sobre"
                        VerticalAlignment="Stretch"
                        Padding="11,0"
                        Background="Transparent"
                        BorderThickness="0">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                            <StackPanel Spacing="6" Padding="4,6">
                                <Image Source="ms-appx:///icon.ico"
                                       Width="32"
                                       Height="32"
                                       HorizontalAlignment="Center"/>
                                <TextBlock Text="por: tales.bouchardet" FontSize="12"/>
                                <TextBlock x:Name="menuVersionItem" FontSize="12"/>
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,2"/>
                                <TextBlock x:Name="menuDotNetItem"
                                           FontSize="11"
                                           FontStyle="Italic"
                                           Foreground="#888888"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button Content="Importar"
                        Click="ImportMenuItem_Click"
                        VerticalAlignment="Stretch"
                        Padding="11,0"
                        Background="Transparent"
                        BorderThickness="0"/>

                <Button Content="Exportar"
                        Click="ExportMenuItem_Click"
                        VerticalAlignment="Stretch"
                        Padding="11,0"
                        Background="Transparent"
                        BorderThickness="0"/>

            </StackPanel>
        </Grid>

        <Rectangle Height="1"
                   VerticalAlignment="Bottom"
                   Grid.Row="0"
                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

        <!-- CONTENT: TabView é construído em C# (conteúdo dinâmico) -->
        <Grid x:Name="contentRoot" Grid.Row="1"/>

    </Grid>
</Window>
